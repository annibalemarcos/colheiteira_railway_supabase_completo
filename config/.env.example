# ==============================================================
# Colheiteira - variáveis de ambiente
# Copie para .env apenas se usar um carregador de .env externo.
# Os scripts locais continuam funcionando sem este arquivo.
# ==============================================================

# Porta local. No Railway, a plataforma injeta PORT automaticamente.
PORT=5840
FLASK_DEBUG=0

# auto = usa Supabase/Postgres quando DATABASE_URL existir; caso contrário, JSON local.
# Opções: auto, files, database
STORAGE_BACKEND=auto

# Cole a connection string do Supabase em Connect > Session pooler (porta 5432),
# ou Transaction pooler (porta 6543). O código aceita postgres:// e postgresql://.
DATABASE_URL=

# Em produção, impede fallback silencioso para disco efêmero se o banco falhar.
# No Railway o padrão já é true; localmente o padrão é false.
STORAGE_STRICT=false

# Use true para forçar NullPool. Na porta 6543 isso é detectado automaticamente.
DB_USE_NULL_POOL=false

# Binários usados pelo plugin Lighthouse no container Railway.
LIGHTHOUSE_BIN=lighthouse
CHROME_PATH=/usr/bin/chromium
LIGHTHOUSE_TIMEOUT=180

# Deixe 1 no Railway para máxima estabilidade dos jobs em memória.
WEB_CONCURRENCY=1
GUNICORN_THREADS=8

# Login simples do painel. Estes são os valores padrão pedidos.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=000000

# Troque por uma sequência longa e aleatória no Railway para assinar as sessões.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# No Railway é ativado automaticamente. Localmente, deixe false para HTTP.
SESSION_COOKIE_SECURE=false
