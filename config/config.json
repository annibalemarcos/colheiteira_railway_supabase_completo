{
  "ortografia": {
    "enabled": true,
    "language": "pt",
    "max_errors": 30,
    "max_words": 1200,
    "ignore_words": [
      "SEO",
      "API",
      "URL",
      "HTML",
      "CSS",
      "JavaScript",
      "Google",
      "Apple",
      "Microsoft",
      "Wikipedia",
      "Wikipédia"
    ],
    "weight": 0.7
  },
  "links": {
    "enabled": true,
    "max_links_check": 60,
    "timeout": 8,
    "max_workers": 5,
    "follow_redirects": true,
    "slow_threshold_seconds": 3.5,
    "weight": 1.3
  },
  "imagens": {
    "enabled": true,
    "max_images_check": 30,
    "timeout": 8,
    "max_workers": 4,
    "max_download_bytes": 2500000,
    "max_size_kb": 700,
    "check_alt_text": true,
    "weight": 1.2
  },
  "social_media": {
    "enabled": true,
    "platforms": [
      "facebook",
      "instagram",
      "twitter",
      "x.com",
      "linkedin",
      "youtube",
      "tiktok"
    ],
    "weight": 0.3
  },
  "lighthouse": {
    "enabled": true,
    "categories": [
      "performance",
      "accessibility",
      "best-practices",
      "seo"
    ],
    "device": "mobile",
    "timeout_seconds": 180,
    "retry_attempts": 2,
    "weight": 2.4
  },
  "seo": {
    "enabled": true,
    "check_meta_tags": true,
    "check_headings": true,
    "check_sitemap": true,
    "check_robots": true,
    "weight": 1.5
  },
  "global": {
    "timeout": 20,
    "user_agent": "Mozilla/5.0 (compatible; Colheiteira/2.0; +https://web-production-f9c45.up.railway.app/)",
    "max_concurrent": 3,
    "retry_attempts": 2,
    "minimum_coverage_for_ranking": 80
  }
}
